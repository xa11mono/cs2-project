# Copy this file to .env. Never commit .env or paste your token into the game.
# Create a Hugging Face token with the Inference Providers permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace_with_your_token

# Optional: override the default image editing model.
HF_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# Optional local port (the game currently expects 47831).
PORT=47831
